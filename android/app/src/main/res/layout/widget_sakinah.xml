<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#F6F3EC">
    <TextView android:id="@+id/widgetTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="سكينة" android:textColor="#173B57" android:textStyle="bold" android:textSize="18sp"/>
    <TextView android:id="@+id/widgetPrayer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="الصلاة القادمة" android:textColor="#10100F" android:textSize="15sp"/>
    <TextView android:id="@+id/widgetTime" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="--:--" android:textColor="#B59A62" android:textSize="24sp" android:textStyle="bold"/>
</LinearLayout>
